{
  "name": "outlook-dual-fetcher",
  "version": "1.3.1",
  "description": "邮箱取件系统 (Outlook IMAP/Graph + Proton Mail API)",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "frontend:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "deploy": "vercel --prod",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:dev:graph-only": "wrangler dev -c wrangler.graph-only.toml",
    "cf:deploy:graph-only": "wrangler deploy -c wrangler.graph-only.toml",
    "cf:dry-run:graph-only": "wrangler deploy -c wrangler.graph-only.toml --dry-run"
  },
  "dependencies": {
    "imapflow": "^1.0.170",
    "lucide-react": "^1.28.0",
    "mailparser": "^3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.0.28",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
